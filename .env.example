# ─────────────────────────────────────────────────────────────
# JARVIS – Vorlage für Umgebungsvariablen
# Kopiere diese Datei zu ".env.local" und trage echte Werte ein.
# ".env.local" wird NICHT ins Repository hochgeladen.
# ─────────────────────────────────────────────────────────────

# ── Kostenlose KI: Google Gemini ──────────────────────────────
# Schlüssel gratis unter https://aistudio.google.com → „Get API key“.
# Mehr ist nicht nötig – ist dieser Wert gesetzt, nutzt JARVIS Gemini.
GEMINI_API_KEY=
# Optional: anderes Modell (Standard: gemini-flash-lite-latest)
# GEMINI_MODEL=gemini-flash-latest

# Optional: Gehirn erzwingen – "gemini", "claude" oder "local"
# JARVIS_AI_PROVIDER=

# Nur nötig, wenn JARVIS_AI_PROVIDER=claude
# Schlüssel erhältst du unter https://platform.claude.com
ANTHROPIC_API_KEY=

# Pflicht für Claude: Zugangscode, den man in JARVIS unter Einstellungen eingibt.
# Schützt davor, dass Fremde mit Ihrer Internet-Adresse auf Ihre Kosten chatten.
JARVIS_ACCESS_CODE=

# Optional: anderes Claude-Modell
# JARVIS_CLAUDE_MODEL=claude-opus-5-5
